// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  tasks     Task[]
  projects  Project[]
  contexts  Context[]
  calendars CalendarIntegration[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  name      String
  status    String   // "active", "completed", "someday"
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Context {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  name      String        // "@Home", "@Office", etc.
  isSystem  Boolean       @default(false)
  tasks     TaskContext[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, name])
}

model Task {
  id                String              @id @default(cuid())
  user              User                @relation(fields: [userId], references: [id])
  userId            String
  project           Project?            @relation(fields: [projectId], references: [id])
  projectId         String?
  title             String
  description       String?
  status            String              // "inbox", "next_action", "waiting_for", "someday", "reference", "done"
  dueDate           DateTime?
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  energyLevel       String?             // "low", "medium", "high"
  timeNeededMinutes Int?
  calendarLinked    Boolean             @default(false)
  calendarEvents    CalendarEventLink[]
  contexts          TaskContext[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model TaskContext {
  taskId    String
  contextId String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  context   Context @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@id([taskId, contextId])
}

model CalendarIntegration {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  provider       String   // "google"
  accessToken    String
  refreshToken   String
  defaultCalId   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CalendarEventLink {
  id              String   @id @default(cuid())
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  provider        String   // "google"
  externalEventId String
  syncedAt        DateTime @default(now())
}
