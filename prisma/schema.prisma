// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks     Task[]
  projects  Project[]
  contexts  Context[]
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          String    @default("inbox") // inbox, next_action, waiting, someday, completed
  dueDate         DateTime?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  energyLevel     String?   // high, medium, low
  timeNeededMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  contexts        TaskContext[]

  @@index([userId])
  @@index([status])
  @@index([projectId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("active") // active, on_hold, completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks       Task[]

  @@index([userId])
}

model Context {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks       TaskContext[]

  @@index([userId])
}

// Join table for many-to-many relationship between Tasks and Contexts
model TaskContext {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contextId String
  context   Context  @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([taskId, contextId])
  @@index([taskId])
  @@index([contextId])
}
